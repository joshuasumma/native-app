{
  "expo": {
    "name": "DAEX",
    "slug": "daex",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "daex",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.daex",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["de", "en", "es", "fr", "it"],
        "WKAppBoundDomains": ["daex.app"],
        "NSCameraUsageDescription": "DÆX benötigt Kamerazugriff, um Notizblock-Seiten zu scannen und daraus Aufgaben zu erstellen.",
        "NSPhotoLibraryUsageDescription": "DÆX benötigt Zugriff auf deine Fotos, um vorhandene Bilder für den Aufgaben-Import zu nutzen.",
        "NSMicrophoneUsageDescription": "DÆX benötigt Mikrofonzugriff, um gesprochene Aufgaben zu transkribieren."
      },
      "buildNumber": "1",
      "associatedDomains": [
        "webcredentials:daex.app"
      ]
    },
    "android": {
      "icon": "./assets/images/logo.png",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CALENDAR"
      ],
      "versionCode": 1,
      "package": "app.daex"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#000000"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/logo.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "DÆX benötigt Zugriff auf deine Kalender, um deine Termine neben deinen Aufgaben anzuzeigen. Die Termine bleiben auf deinem Gerät.",
          "remindersPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class app.daex.taskplayer.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63d3b418-e65e-41a5-b2c7-c543da56f444"
      }
    }
  }
}
